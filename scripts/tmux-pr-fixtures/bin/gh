#!/usr/bin/env bash
# Fake gh for scripts/tmux-pr-test.bats. See docs/tmux-pr-menu.md#tests

set -u

readonly FIXTURES=${BASH_SOURCE[0]%/*}/..

printf '%s\n' "$*" >>"${GH_LOG:-/dev/null}"
if [[ -n ${GH_FAIL-} ]]; then
  printf '%s\nsecond line\n' "$GH_FAIL" >&2
  exit 1
fi

jq_program=.
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  [[ ${args[i]} == --jq ]] && jq_program=${args[i + 1]}
done

case "${1-} ${2-}" in
  'search prs') fixture=${GH_SEARCH_FIXTURE:-search-prs.json} ;;
  'pr view') fixture=pr-view.json ;;
  'pr diff') exec cat -- "$FIXTURES/pr.diff" ;;
  'pr review') exit 0 ;;
  'api graphql')
    if [[ $* == *organizations* ]]; then
      fixture=orgs.json
    else
      fixture=members.json
    fi
    ;;
  *)
    printf 'fake gh: unsupported command: %s\n' "$*" >&2
    exit 2
    ;;
esac

exec jq -r -- "$jq_program" "$FIXTURES/$fixture"
